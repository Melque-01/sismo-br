# Copie para .env e troque a senha (não versione o .env).
DB_PASSWORD=troque-esta-senha
# Porta publicada no host para acesso direto (o túnel usa a rede interna).
APP_PORT=8080

# Login (obrigatório). Sem LOGIN_SENHA, ninguém entra.
LOGIN_EMAIL=voce@exemplo.com
LOGIN_SENHA=troque-esta-senha-de-login
# Segredo que assina o cookie de sessão (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=
